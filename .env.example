# ── Security ──────────────────────────────────────────────────────────────────
# Required. Use long random strings. Never commit real values.
SECRET_KEY=<change-me>
JWT_SECRET_KEY=<change-me>

# ── Database ──────────────────────────────────────────────────────────────────
# Required. PostgreSQL only — SQLite is not supported.
# Used by scripts/setup_db.sh (provisioning) and the application (connection).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safion
DB_USER=safion
DB_PASSWORD=<change-me>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Access token: JWT_ACCESS_HOURS overrides JWT_ACCESS_MINUTES when > 0.
JWT_ACCESS_MINUTES=15
JWT_ACCESS_HOURS=0
JWT_REFRESH_DAYS=7

# ── YOLO ──────────────────────────────────────────────────────────────────────
YOLO_DEVICE=auto
CONFIDENCE_THRESHOLD=0.4

# ── InsightFace ───────────────────────────────────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l
PREFER_GPU=true
FACE_DET_SCORE_MIN=0.45
EMBEDDING_QUALITY_MIN=0.30

# ── Identity matching ─────────────────────────────────────────────────────────
# Cosine similarity threshold for auto-assigning a face embedding to an
# existing identity.  Lower = more aggressive auto-match (risk of cross-person
# merges).  Production recommendation: 0.35–0.45.
IDENTITY_MATCH_THRESHOLD=0.35
OUTLIER_MIN_SIMILARITY=0.35

# ── Multi-prototype model ─────────────────────────────────────────────────────
MAX_PROTOTYPES=5
PROTO_MERGE_THRESHOLD=0.70

# ── Merge suggestions ─────────────────────────────────────────────────────────
SUGGESTION_THRESHOLD=0.28
SUGGESTION_MAX_RESULTS=30
SIMILARITY_SOFT_THRESHOLD=0.35

# ── Temporal tracker ──────────────────────────────────────────────────────────
TRACK_IOU_THRESHOLD=0.30
TRACK_MAX_LOST=10
TRACK_MIN_FRAMES=3
TRACK_MIN_EMBEDDINGS=3

# ── Clustering (DBSCAN) ───────────────────────────────────────────────────────
CLUSTER_EPS=0.40
CLUSTER_MIN_SAMPLES=2
CLUSTER_EVERY_N_VIOLATIONS=50

# ── Violation deduplication ───────────────────────────────────────────────────
VIOLATION_COOLDOWN=10
IDENTITY_VIOLATION_COOLDOWN=30

# ── Streams ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_STREAMS=8
FRAME_RATE_LIMIT=30
FACE_EMBED_EVERY_N_FRAMES=5
IDENTITY_RECHECK_SECONDS=10
MAX_PENDING_EMBEDDINGS=5
PROCESS_WIDTH=640
STREAM_OUTPUT_FPS=15
STREAM_JPEG_QUALITY=80

# Stream stall detection and restart
STREAM_STALL_TIMEOUT_S=10.0
STREAM_RESTART_DELAY_S=3.0

# ── Task queue ────────────────────────────────────────────────────────────────
TASK_WORKER_THREADS=2
TASK_QUEUE_MAXSIZE=200

# ── Identity temporal bias ────────────────────────────────────────────────────
TEMPORAL_BOOST=0.10
RECENT_WINDOW=15.0
EMA_ALPHA=0.3
STRONG_MATCH_THRESHOLD=0.6

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false

# ── Default admin (first-run bootstrap) ─────────────────────────────────────────
# If no admin user exists at startup, one is created with these credentials.
# Leave blank to skip automatic admin creation.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<change-me>
DEFAULT_ADMIN_EMAIL=

# ── Identity Import ────────────────────────────────────────────────────────────
IDENTITY_STORAGE_PATH=
IMPORT_MAX_ZIP_MB=100

# ── Frontend ──────────────────────────────────────────────────────────────────
# Required for frontend development outside of the Flask app context.
# Set this to the backend API URL (e.g., http://localhost:5000).
REACT_APP_API_URL=

# ── Production hardening ──────────────────────────────────────────────────────
# Rate limiter: use Redis (or Memcached) for shared counters across
# Gunicorn workers.  Defaults to in-memory (per-worker, not suitable for
# multi-worker deployments).
#RATELIMIT_STORAGE_URI=redis://localhost:6379

# CORS: in production, lock origins to your frontend domain(s).
# Defaults to * (any origin) when not set.
#CORS_ORIGINS=https://safion.example.com