# ── Security ─────────────────────────────────────────────────────────────────
# Change BOTH before any production or shared deployment
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=a-different-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — fine for single-server / development use)
DATABASE_URL=sqlite:///safion.db
# Postgres (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/safion

# ── YOLO ──────────────────────────────────────────────────────────────────────
MODEL_PATH=../best.pt           # path to best.pt relative to backend/
YOLO_DEVICE=auto                # auto | cpu | cuda
CONFIDENCE_THRESHOLD=0.4        # YOLO detection confidence gate

# ── InsightFace ───────────────────────────────────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l     # buffalo_l = RetinaFace + ArcFace 512-dim
FACE_DET_SCORE_MIN=0.60         # minimum RetinaFace detection confidence

# Face embedding quality gate (det_score × 0.7 + face_area_ratio × 0.3)
EMBEDDING_QUALITY_MIN=0.30

# ── Identity matching ─────────────────────────────────────────────────────────
# Cosine similarity threshold for auto-assigning an embedding to an existing identity.
# Empirical range for same person in surveillance video with PPE (25° turn):
#   quality-weighted mean: 0.38 – 0.50
#   different person:      -0.10 – 0.15
# 0.35 captures the cross-track same-person range with a safe margin.
IDENTITY_MATCH_THRESHOLD=0.35

# Cosine similarity below which an embedding is stored but does NOT update
# the prototype (outlier rejection).
OUTLIER_MIN_SIMILARITY=0.35

# ── Multi-prototype model ─────────────────────────────────────────────────────
MAX_PROTOTYPES=5                # max representative vectors per identity in cache
PROTO_MERGE_THRESHOLD=0.70      # similarity above which two embeddings merge into same prototype

# ── Merge suggestions ─────────────────────────────────────────────────────────
# MUST be below IDENTITY_MATCH_THRESHOLD — suggestions exist to catch pairs
# that failed auto-matching.  Cost of a false suggestion is trivial (one click);
# cost of a missed suggestion is an operator manually hunting through 100s of identities.
SUGGESTION_THRESHOLD=0.28
SUGGESTION_MAX_RESULTS=30
SIMILARITY_SOFT_THRESHOLD=0.35  # coverage signal cutoff in identity_similarity()

# ── Temporal tracker (per stream) ─────────────────────────────────────────────
TRACK_IOU_THRESHOLD=0.30        # IoU required to link a detection to a track
TRACK_MAX_LOST=10               # frames a track survives without a match
TRACK_MIN_FRAMES=3              # frames before a track is confirmed
TRACK_MIN_EMBEDDINGS=3          # embeddings before identity assignment

# ── Clustering (DBSCAN) ───────────────────────────────────────────────────────
CLUSTER_EPS=0.40                # cosine-distance eps (1 - cosine_similarity)
CLUSTER_MIN_SAMPLES=2           # min embeddings for a DBSCAN core point
CLUSTER_EVERY_N_VIOLATIONS=50   # auto-trigger clustering every N violations (0=off)

# ── Violation deduplication ───────────────────────────────────────────────────
VIOLATION_COOLDOWN=10           # seconds between position-bucket jobs (worker)
IDENTITY_VIOLATION_COOLDOWN=30  # seconds between DB rows for same identity+type (queue)

# ── Streams ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_STREAMS=8
FRAME_RATE_LIMIT=30
STREAM_JPEG_QUALITY=80

# ── Async task workers ────────────────────────────────────────────────────────
TASK_WORKER_THREADS=2
TASK_QUEUE_MAXSIZE=200

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
