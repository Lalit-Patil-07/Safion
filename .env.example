# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=a-different-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector (required — SQLite is no longer supported)
# The postgres service in docker-compose.yml satisfies this automatically.
DATABASE_URL=postgresql://safion:safion@localhost:5432/safion

# ── YOLO ──────────────────────────────────────────────────────────────────────
MODEL_PATH=../best.pt
YOLO_DEVICE=auto
CONFIDENCE_THRESHOLD=0.4

# ── InsightFace ───────────────────────────────────────────────────────────────
INSIGHTFACE_MODEL=buffalo_l
FACE_DET_SCORE_MIN=0.60
EMBEDDING_QUALITY_MIN=0.30

# ── Identity matching ─────────────────────────────────────────────────────────
IDENTITY_MATCH_THRESHOLD=0.35
OUTLIER_MIN_SIMILARITY=0.35

# ── Multi-prototype model ─────────────────────────────────────────────────────
MAX_PROTOTYPES=5
PROTO_MERGE_THRESHOLD=0.70

# ── Merge suggestions ─────────────────────────────────────────────────────────
SUGGESTION_THRESHOLD=0.28
SUGGESTION_MAX_RESULTS=30
SIMILARITY_SOFT_THRESHOLD=0.35

# ── Temporal tracker (per stream) ─────────────────────────────────────────────
TRACK_IOU_THRESHOLD=0.30
TRACK_MAX_LOST=10
TRACK_MIN_FRAMES=3
TRACK_MIN_EMBEDDINGS=3

# ── Clustering (DBSCAN) ───────────────────────────────────────────────────────
CLUSTER_EPS=0.40
CLUSTER_MIN_SAMPLES=2
CLUSTER_EVERY_N_VIOLATIONS=50

# ── Violation deduplication ───────────────────────────────────────────────────
VIOLATION_COOLDOWN=10
IDENTITY_VIOLATION_COOLDOWN=30

# ── Streams ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_STREAMS=8
FRAME_RATE_LIMIT=30
STREAM_JPEG_QUALITY=80

# ── Async task workers ────────────────────────────────────────────────────────
TASK_WORKER_THREADS=2
TASK_QUEUE_MAXSIZE=200

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
