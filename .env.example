# ── Security (change both before production deployment) ──────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — fine for single-server deployments)
DATABASE_URL=sqlite:///safion.db
# Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/safion

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=../best.pt
YOLO_DEVICE=auto          # auto | cpu | cuda
CONFIDENCE_THRESHOLD=0.4

# ── Face recognition ──────────────────────────────────────────────────────────
FACE_MATCH_THRESHOLD=0.50     # lower = stricter. 0.45-0.55 is the useful range.
FACE_HEAD_CROP_RATIO=0.35     # fraction of person bbox height used as head region
FACE_HEAD_CROP_PADDING=0.15   # fractional padding around the head crop
FACE_MIN_CROP_SIZE=120        # minimum pixel dimension for the head crop
FACE_MIN_QUALITY_SCORE=0.40   # reject embeddings below this quality (0.0-1.0)

# ── Streams ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_STREAMS=8
FRAME_RATE_LIMIT=30
STREAM_JPEG_QUALITY=80
VIOLATION_COOLDOWN=10         # seconds between violation logs for same person+type

# ── Async task workers ────────────────────────────────────────────────────────
TASK_WORKER_THREADS=2
TASK_QUEUE_MAXSIZE=200

# ── Development ───────────────────────────────────────────────────────────────
DEBUG=false
